{
  "name": "pilates-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión y agendamiento de clases de pilates",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:push": "npm run --prefix backend prisma:push",
    "db:studio": "npm run --prefix backend prisma:studio",
    "backend:dev": "npm run --prefix backend start:dev",
    "backend:build": "npm run --prefix backend build",
    "frontend:dev": "npm run --prefix frontend dev",
    "frontend:build": "npm run --prefix frontend build"
  }
}
