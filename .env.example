# ==============================================================================
# PILATES BOOKING SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pilates_dev?schema=public

# Security & JWT
JWT_SECRET=super-secret-key-change-in-staging-and-prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-staging-and-prod
JWT_REFRESH_EXPIRATION=7d

# File Storage (MinIO local / AWS S3 / Cloudinary)
STORAGE_DRIVER=local # 'local', 's3', 'cloudinary'
STORAGE_BUCKET=pilates-vouchers-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Payment Gateways (Sandbox / Live)
MERCADOPAGO_ACCESS_TOKEN=
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# Notifications
RESEND_API_KEY=
EMAIL_FROM="Pilates Studio <contacto@estudiopilates.cl>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
